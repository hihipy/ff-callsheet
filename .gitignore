# --- local rules: edit freely, never overwritten -----------------------------
# Cached Sleeper player map. Roughly 5MB, refetched daily, never source.
.cache/
players-*.json

# Generated league snapshots. These carry other managers' display names, so
# they stay out of history even when the league itself is public.
out/

# lychee link-checker cache, created on CI runners
.lycheecache
