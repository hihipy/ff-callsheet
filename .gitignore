# --- editors and IDEs ---------------------------------------------------------
# .vscode/* rather than .vscode/, so the negations below stay reachable. A
# negation cannot re-include a file whose parent directory is excluded.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.code-workspace
.idea/
*.iml
*.ipr
*.iws
.fleet/
.zed/
.history/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*.swn
*~
Session.vim
.netrwhist
.ionide/

# --- agent and assistant local state ------------------------------------------
.claude/settings.local.json

# --- secrets and credentials --------------------------------------------------
# Deliberately broad. A leaked key costs more than a hidden fixture. Where a
# repo needs a fixture certificate, add a scoped negation below the block, for
# example !tests/fixtures/*.pem, which works because tests/fixtures/ is not
# itself ignored.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
# "*.key" is deliberately absent: Keynote decks are directories named *.key.
secrets.json
credentials.json
service-account*.json
.secrets/

# --- local databases and dumps ------------------------------------------------
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
*.dump

# --- build noise and scratch --------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej
*.pid
.tmp/
.scratch/

# --- go -----------------------------------------------------------------------
# Binaries. Root-anchored so a directory of the same name stays tracked, since
# a Go binary has no extension to distinguish it.
/ff-callsheet
/callsheet
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html
# Dependency directory, only present when vendoring is off and someone ran the
# old workflow by accident.
/vendor/
# goreleaser
dist/

# --- r ------------------------------------------------------------------------
.Rhistory
.Rapp.history
.RData
.Ruserdata
*_cache/
/cache/
.Rproj.user/

